# Gentleman Guardian Angel Configuration
# https://github.com/Gentleman-Programming/gentleman-guardian-angel

PROVIDER="opencode"

# .NET 10 + C# + Razor Views
FILE_PATTERNS="*.cs,*.razor,*.cshtml,*.json,*.yaml,*.yml,*.md"

EXCLUDE_PATTERNS="*.Designer.cs,*.g.cs,*.g.i.cs,*Migrations/*.cs,PRD.md,DESIGN.md,mockups/**/DESIGN.md"

RULES_FILE="AGENTS.md"

STRICT_MODE="true"

TIMEOUT="600"

PR_BASE_BRANCH="main"
