@model BanterBotSports.Entities.ViewModels.ConfiguracionOrganizadorViewModel
@{
    ViewData["Title"] = "Panel Organizador";
    var placeholder = Model.PorcentajeOrganizadorGlobal ?? Model.PorcentajeMinimo;
}

<div class="mb-6">
    <a asp-controller="Torneo" asp-action="Index" class="text-on-surface-variant hover:text-on-surface text-sm flex items-center gap-1 mb-2 transition-colors">
        <span class="material-symbols-outlined text-sm">arrow_back</span> Mis torneos
    </a>
    <h1 class="text-2xl font-black tracking-tighter text-on-surface uppercase">Configuración del organizador</h1>
    <p class="text-on-surface-variant text-sm mt-1">Definí tu porcentaje global para nuevos torneos.</p>
</div>

<div class="max-w-2xl space-y-4">
    <div class="bg-surface-container-low rounded-2xl p-5 border border-outline/10 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        <div>
            <p class="text-on-surface-variant text-xs uppercase tracking-widest font-bold">Plataforma</p>
            <p class="font-black text-lg text-on-surface">@Model.PorcentajePlataforma.ToString("0.##")%</p>
        </div>
        <div>
            <p class="text-on-surface-variant text-xs uppercase tracking-widest font-bold">Mínimo organizador</p>
            <p class="font-black text-lg text-on-surface">@Model.PorcentajeMinimo.ToString("0.##")%</p>
        </div>
        <div>
            <p class="text-on-surface-variant text-xs uppercase tracking-widest font-bold">Máximo organizador</p>
            <p class="font-black text-lg text-on-surface">@Model.PorcentajeMaximo.ToString("0.##")%</p>
        </div>
    </div>

    <div class="bg-surface-container-low rounded-2xl p-6 border border-outline/10">
        <form asp-action="Configuracion" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All"
                     class="p-4 bg-error/10 rounded-xl border-l-4 border-error text-error text-sm"></div>
            }

            <div>
                <label asp-for="PorcentajeOrganizadorGlobal" class="block text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1"></label>
                <input asp-for="PorcentajeOrganizadorGlobal"
                       type="number"
                       step="0.01"
                       min="@Model.PorcentajeMinimo"
                       max="@Model.PorcentajeMaximo"
                       placeholder="@placeholder.ToString("0.##")"
                       class="w-full px-4 py-2.5 bg-surface-container rounded-xl border border-outline/20 text-on-surface focus:outline-none focus:border-primary transition-colors" />
                <p class="text-xs text-on-surface-variant mt-1">Rango permitido: @Model.PorcentajeMinimo.ToString("0.##")% a @Model.PorcentajeMaximo.ToString("0.##")%</p>
                <span asp-validation-for="PorcentajeOrganizadorGlobal" class="text-error text-xs mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full py-3 bg-gradient-to-r from-primary to-primary-container text-on-primary-container font-bold rounded-xl active:scale-95 transition-all flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-sm">save</span>
                Guardar configuración
            </button>
        </form>
    </div>
</div>
