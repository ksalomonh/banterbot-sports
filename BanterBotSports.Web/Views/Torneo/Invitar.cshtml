@using BanterBotSports.Entities
@model Torneo
@{
    ViewData["Title"] = "Invitar al Torneo";
}

<h2>Invitar a @Model.Nombre</h2>

<div class="card mt-3">
    <div class="card-body">
        <p>Compartí este link con los participantes que querés invitar:</p>
        <div class="input-group">
            <input type="text" class="form-control" id="invite-url" value="@ViewBag.InviteUrl" readonly />
            <button class="btn btn-outline-secondary" type="button" onclick="copyInviteUrl()">Copiar</button>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Dashboard" asp-route-id="@Model.Id" class="btn btn-secondary">Volver al Dashboard</a>
</div>

@section Scripts {
<script>
function copyInviteUrl() {
    const input = document.getElementById("invite-url");
    navigator.clipboard.writeText(input.value).then(() => {
        alert("Link copiado al portapapeles!");
    });
}
</script>
}
