@model BanterBotSports.Entities.ViewModels.TorneoCreateViewModel
@{
    ViewData["Title"] = "Nuevo Torneo";
}

<h2>Crear Torneo</h2>

<div class="row">
    <div class="col-md-7">
        <form asp-action="Nuevo" method="post" id="nuevo-torneo-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre del torneo</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumJornadas" class="form-label">Número de jornadas</label>
                <input asp-for="NumJornadas" class="form-control" type="number" min="1" max="100" />
                <span asp-validation-for="NumJornadas" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MontoInscripcion" class="form-label">Monto de inscripción ($)</label>
                <input asp-for="MontoInscripcion" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MontoInscripcion" class="text-danger"></span>
            </div>

            <hr />
            <h5>Puntuación</h5>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PtosResultado" class="form-label">Pts. Resultado</label>
                    <input asp-for="PtosResultado" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="PtosResultado" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PtosMarcador" class="form-label">Pts. Marcador Exacto</label>
                    <input asp-for="PtosMarcador" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="PtosMarcador" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="PtosGolesJornada" class="form-label">Pts. Goles Jornada</label>
                    <input asp-for="PtosGolesJornada" class="form-control" type="number" min="0" max="100" />
                    <span asp-validation-for="PtosGolesJornada" class="text-danger"></span>
                </div>
            </div>

            <hr />
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Distribución de Premios</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="agregar-posicion">
                    + Agregar posición
                </button>
            </div>
            <p class="text-muted small mb-2">
                Configurá el porcentaje del pozo premiado para cada posición. La suma debe ser 100%.
            </p>

            <div id="premios-container">
                @for (int i = 0; i < Model.ConfiguracionPremios.Count; i++)
                {
                    <div class="row g-2 mb-2 premio-row">
                        <div class="col-5">
                            <input name="ConfiguracionPremios[@i].Posicion"
                                   type="number" min="1" max="100"
                                   value="@Model.ConfiguracionPremios[i].Posicion"
                                   class="form-control form-control-sm"
                                   placeholder="Posición" required />
                        </div>
                        <div class="col-5">
                            <div class="input-group input-group-sm">
                                <input name="ConfiguracionPremios[@i].Porcentaje"
                                       type="number" step="0.01" min="0" max="100"
                                       value="@Model.ConfiguracionPremios[i].Porcentaje"
                                       class="form-control porcentaje-input"
                                       placeholder="%" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-2">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-posicion">✕</button>
                        </div>
                    </div>
                }
            </div>

            <div class="text-muted small mb-3">
                Total asignado: <span id="total-porcentaje">0</span>%
                <span id="total-warning" class="text-danger ms-2" style="display:none">⚠ Debe sumar 100%</span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Crear Torneo</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        let premioIndex = @Model.ConfiguracionPremios.Count;
        const container = document.getElementById("premios-container");
        const totalSpan = document.getElementById("total-porcentaje");
        const warningSpan = document.getElementById("total-warning");

        function calcTotal() {
            const inputs = container.querySelectorAll(".porcentaje-input");
            let total = 0;
            inputs.forEach(i => total += parseFloat(i.value) || 0);
            totalSpan.textContent = total.toFixed(2);
            warningSpan.style.display = Math.abs(total - 100) > 0.01 ? "inline" : "none";
        }

        document.getElementById("agregar-posicion").addEventListener("click", () => {
            const row = document.createElement("div");
            row.className = "row g-2 mb-2 premio-row";
            row.innerHTML = `
                <div class="col-5">
                    <input name="ConfiguracionPremios[${premioIndex}].Posicion"
                           type="number" min="1" max="100"
                           class="form-control form-control-sm" placeholder="Posición" required />
                </div>
                <div class="col-5">
                    <div class="input-group input-group-sm">
                        <input name="ConfiguracionPremios[${premioIndex}].Porcentaje"
                               type="number" step="0.01" min="0" max="100"
                               class="form-control porcentaje-input" placeholder="%" required />
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                <div class="col-2">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-posicion">✕</button>
                </div>`;
            container.appendChild(row);
            premioIndex++;
            calcTotal();
        });

        container.addEventListener("input", e => {
            if (e.target.classList.contains("porcentaje-input")) calcTotal();
        });

        container.addEventListener("click", e => {
            if (e.target.classList.contains("remove-posicion")) {
                e.target.closest(".premio-row").remove();
                calcTotal();
            }
        });

        calcTotal();
    </script>
}
