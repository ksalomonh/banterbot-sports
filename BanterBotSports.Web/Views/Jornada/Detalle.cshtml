@using BanterBotSports.Entities
@using BanterBotSports.Entities.Enums
@model Jornada
@{
    ViewData["Title"] = $"Jornada {Model.Numero}";
    var esOrganizador = (bool)(ViewBag.EsOrganizador ?? false);
    var torneo = ViewBag.Torneo as Torneo;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Jornada @Model.Numero</h2>
        @if (torneo is not null)
        {
            <small class="text-muted">
                <a asp-controller="Torneo" asp-action="Dashboard" asp-route-id="@torneo.Id">@torneo.Nombre</a>
            </small>
        }
    </div>
    <span class="badge bg-primary fs-6">@Model.Estado</span>
</div>

@if (Model.DeadlineUtc.HasValue)
{
    <div class="alert alert-warning">
        <strong>Cierre de predicciones:</strong> @Model.DeadlineUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
    </div>
}

@if (esOrganizador)
{
    <div class="card mb-3">
        <div class="card-header fw-bold">Acciones del Organizador</div>
        <div class="card-body d-flex gap-2 flex-wrap">
            @if (Model.Estado == EstadoJornada.PendientePartidos || Model.Estado == EstadoJornada.Cerrada)
            {
                <form asp-action="Abrir" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success">Abrir Jornada</button>
                </form>
            }
            @if (Model.Estado == EstadoJornada.Abierta)
            {
                <form asp-action="Cerrar" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-warning">Cerrar Jornada</button>
                </form>
            }
            @if (Model.Estado == EstadoJornada.Cerrada)
            {
                <form asp-action="Finalizar" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger">Finalizar Jornada</button>
                </form>
            }
        </div>
    </div>

    <!-- Assign Match Form -->
    @if (Model.Estado == EstadoJornada.PendientePartidos || Model.Estado == EstadoJornada.Abierta)
    {
        <div class="card mb-3">
            <div class="card-header fw-bold">Agregar Partido desde API-Football</div>
            <div class="card-body">
                <form asp-action="AsignarPartido" asp-route-id="@Model.Id" method="post">
                    <div class="input-group">
                        <input type="text" name="externalId" class="form-control"
                               placeholder="ID externo del partido (ej: 1035041)" required />
                        <button type="submit" class="btn btn-primary">Agregar</button>
                    </div>
                </form>
                <div class="mt-2">
                    <small class="text-muted">
                        O buscar por liga:
                        <input type="text" id="buscar-q" class="form-control form-control-sm mt-1"
                               placeholder="Ingresá el ID de competición (ej: 128 para Liga MX)" />
                    </small>
                    <div id="buscar-resultados" class="list-group mt-2"></div>
                </div>
            </div>
        </div>
    }
}

<!-- Matches List -->
<div class="card">
    <div class="card-header fw-bold">Partidos (@Model.Partidos.Count)</div>
    @if (!Model.Partidos.Any())
    {
        <div class="card-body text-muted">No hay partidos asignados todavía.</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var partido in Model.Partidos.OrderBy(p => p.KickOffUtc))
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@partido.Equipo1</strong> vs <strong>@partido.Equipo2</strong>
                            <br />
                            <small class="text-muted">@partido.KickOffUtc.ToLocalTime().ToString("dd/MM HH:mm")</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-secondary">@partido.Estado</span>
                            @if (partido.GolesEquipo1Oficial.HasValue && partido.GolesEquipo2Oficial.HasValue)
                            {
                                <br />
                                <strong>@partido.GolesEquipo1Oficial - @partido.GolesEquipo2Oficial</strong>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (Model.Estado == EstadoJornada.Abierta)
{
    <div class="mt-3">
        <a asp-controller="Prediccion" asp-action="Form" asp-route-jornadaId="@Model.Id"
           class="btn btn-success">
            Ingresar mis predicciones
        </a>
    </div>
}

@section Scripts {
@if (esOrganizador)
{
<script>
    const jornadaId = @Model.Id;
    const buscarInput = document.getElementById("buscar-q");
    const resultadosDiv = document.getElementById("buscar-resultados");

    if (buscarInput) {
        let debounceTimer;
        buscarInput.addEventListener("input", () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(async () => {
                const q = buscarInput.value.trim();
                if (!q) { resultadosDiv.innerHTML = ""; return; }

                const resp = await fetch(`/jornada/${jornadaId}/buscar-partidos?q=${encodeURIComponent(q)}`);
                const matches = await resp.json();
                resultadosDiv.innerHTML = "";
                matches.forEach(m => {
                    const item = document.createElement("a");
                    item.className = "list-group-item list-group-item-action";
                    item.href = "#";
                    item.textContent = `${m.equipo1} vs ${m.equipo2} (ID: ${m.externalId})`;
                    item.addEventListener("click", (e) => {
                        e.preventDefault();
                        document.querySelector("input[name='externalId']").value = m.externalId;
                        resultadosDiv.innerHTML = "";
                    });
                    resultadosDiv.appendChild(item);
                });
            }, 400);
        });
    }
</script>
}
}
