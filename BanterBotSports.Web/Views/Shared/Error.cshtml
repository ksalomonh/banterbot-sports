@model ErrorViewModel
@using Microsoft.AspNetCore.Http
@{
    Layout = "_Layout";
    bool is404 = Model.StatusCode == StatusCodes.Status404NotFound;
    ViewData["Title"] = is404 ? "Página no encontrada" : "Error del servidor";
}

<div class="min-h-[80vh] flex items-center justify-center px-4 py-16">
    <div class="text-center max-w-md">

        @* Icon *@
        <div class="mb-6 flex justify-center">
            <span class="material-symbols-outlined text-8xl @(is404 ? "text-primary" : "text-error") opacity-80">
                @(is404 ? "search_off" : "error")
            </span>
        </div>

        @* Status code badge *@
        <div class="mb-4 inline-flex items-center gap-2 bg-surface-container px-4 py-1 rounded-full">
            <span class="text-xs font-bold tracking-widest text-on-surface-variant uppercase">@Model.StatusCode</span>
        </div>

        @* Heading *@
        <h1 class="text-4xl font-black tracking-tighter text-on-surface mb-4">
            @(is404 ? "Página no encontrada" : "Error del servidor")
        </h1>

        @* Message *@
        <p class="text-on-surface-variant text-lg mb-8">
            @(is404
                ? "La página que buscás no existe o fue movida."
                : "Algo salió mal. El equipo técnico ya fue notificado.")
        </p>

        @* RequestId for 500 errors *@
        @if (!is404 && Model.ShowRequestId)
        {
            <div class="mb-8 px-4 py-3 rounded-xl bg-surface-container-high text-left">
                <p class="text-xs text-on-surface-variant font-mono">
                    <span class="font-bold text-on-surface">Request ID:</span>
                    <code class="ml-2 text-secondary">@Model.RequestId</code>
                </p>
            </div>
        }

        @* CTA button *@
        @if (is404)
        {
            <a href="/torneo"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-gradient-to-br from-primary to-primary-container text-on-primary font-bold tracking-tight transition-all hover:scale-[1.02] active:scale-95 shadow-lg">
                <span class="material-symbols-outlined text-base">stadium</span>
                Ir a mis torneos
            </a>
        }
        else
        {
            <a href="/"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-gradient-to-br from-primary to-primary-container text-on-primary font-bold tracking-tight transition-all hover:scale-[1.02] active:scale-95 shadow-lg">
                <span class="material-symbols-outlined text-base">home</span>
                Volver al inicio
            </a>
        }

    </div>
</div>
