@using BanterBotSports.Web.Infrastructure
@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BanterBot Sports</title>
    @await Html.PartialAsync("_TailwindHead")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen bg-background text-on-surface">

    @* Mobile TopNav: visible on mobile only *@
    <header class="md:hidden fixed top-0 w-full z-50 glass-nav shadow-[0_4px_40px_0_rgba(105,218,255,0.08)] flex items-center justify-between px-4 py-3">
        <a asp-controller="Home" asp-action="Index"
           class="flex items-center gap-2 text-xl font-black tracking-tighter text-primary uppercase font-headline">
            <img src="~/images/logo-icon.png" alt="BanterBot Sports" class="w-10 h-10 rounded-lg" onerror="this.style.display='none'">
            BanterBot Sports
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Account" asp-action="Profile"
               class="w-9 h-9 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-sm">account_circle</span>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login"
               class="px-3 py-1.5 rounded-xl bg-gradient-to-br from-primary to-primary-container text-on-primary-container text-xs font-bold transition-all hover:scale-[1.02] active:scale-95">
                Ingresar
            </a>
        }
    </header>

    @* Desktop TopNav: hidden on mobile, glass-nav on md+ *@
    <nav class="hidden md:flex fixed top-0 w-full z-50 glass-nav shadow-[0_4px_40px_0_rgba(105,218,255,0.08)] justify-between items-center px-6 py-4">
        @* Logo *@
        <a asp-controller="Home" asp-action="Index"
           class="flex items-center gap-2 text-2xl font-black tracking-tighter text-primary uppercase font-headline">
            <img src="~/images/logo-icon.png" alt="BanterBot Sports" class="w-8 h-8 rounded-lg" onerror="this.style.display='none'">
            BanterBot Sports
        </a>
        @* Center nav links *@
        <div class="flex items-center gap-8">
            <a asp-controller="Torneo" asp-action="Index"
               class="font-bold tracking-tight text-on-surface/70 hover:text-on-surface transition-colors">
                Mis Torneos
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Torneo" asp-action="Nuevo"
                   class="font-bold tracking-tight text-on-surface/70 hover:text-on-surface transition-colors">
                    Crear Torneo
                </a>
            }
        </div>
        @* Right: user / auth *@
        <div class="flex items-center gap-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-on-surface-variant text-sm font-medium">@(User.FindFirstValue(AppClaimTypes.NombreDisplay) ?? User.Identity?.Name)</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    <button type="submit"
                            class="px-4 py-2 rounded-xl bg-surface-container-high hover:bg-surface-bright text-on-surface text-sm font-bold transition-colors">
                        Salir
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                   class="px-4 py-2 rounded-xl bg-gradient-to-br from-primary to-primary-container text-on-primary-container text-sm font-bold transition-all hover:scale-[1.02] active:scale-95">
                    Ingresar
                </a>
            }
        </div>
    </nav>

    @* Static Banter Rail: desktop only (lg+), fixed right *@
    <aside class="fixed right-0 top-20 h-[calc(100vh-5rem)] w-80 rounded-l-2xl bg-surface-container-low/70 backdrop-blur-2xl shadow-[-20px_0_40px_rgba(0,0,0,0.3)] hidden lg:flex flex-col p-6 gap-4 z-40">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-xl bg-primary/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-primary text-lg">psychology</span>
            </div>
            <div>
                <h3 class="text-primary font-bold font-headline">Banter Rail</h3>
                <p class="text-[10px] text-on-surface-variant font-bold uppercase tracking-widest">The Neon Colosseum</p>
            </div>
        </div>
        <div class="flex flex-col gap-4 overflow-y-auto pr-2 flex-1">
            <div class="p-4 bg-surface-bright rounded-xl border-l-4 border-secondary">
                <div class="flex items-center gap-2 mb-2">
                    <span class="material-symbols-outlined text-secondary text-sm">forum</span>
                    <span class="text-[10px] font-bold text-secondary tracking-widest uppercase">Live Banter</span>
                </div>
                <p class="text-sm text-on-surface leading-relaxed">
                    BanterBot está listo. ¡Hacé tu predicción antes de que cierren las apuestas!
                </p>
            </div>
            <div class="flex flex-col gap-2 mt-2">
                <div class="p-3 bg-surface-container-high rounded-xl hover:translate-x-[-4px] transition-transform cursor-pointer">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-[10px] font-bold text-on-surface-variant uppercase">Próximas Jornadas</span>
                        <span class="text-[10px] text-secondary font-bold">LIVE</span>
                    </div>
                    <p class="text-xs text-on-surface">Revisá los partidos de esta semana</p>
                </div>
            </div>
        </div>
        <button class="w-full py-3 bg-gradient-to-r from-primary to-primary-container text-on-primary-container font-bold rounded-xl active:scale-95 transition-all flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-sm">campaign</span>
            Unirse al Banter
        </button>
    </aside>

    @* Main content area: pb for bottom nav on mobile, pt for top nav on desktop, pr for rail on lg *@
    <div class="pt-16 pb-24 md:pb-0 md:pt-20 lg:pr-80">
        <main role="main" class="max-w-7xl mx-auto px-4 md:px-6 py-6">

            @* TempData Toasts — Tailwind-styled *@
            @if (TempData[TempDataKeys.Success] is string success)
            {
                <div class="flex items-center gap-3 mb-6 p-4 bg-secondary/10 rounded-xl border-l-4 border-secondary"
                     role="alert">
                    <span class="material-symbols-outlined text-secondary">check_circle</span>
                    <span class="text-on-surface text-sm font-medium">@success</span>
                    <button type="button" onclick="this.parentElement.remove()"
                            class="ml-auto text-on-surface-variant hover:text-on-surface transition-colors">
                        <span class="material-symbols-outlined text-sm">close</span>
                    </button>
                </div>
            }
            @if (TempData[TempDataKeys.Error] is string error)
            {
                <div class="flex items-center gap-3 mb-6 p-4 bg-error/10 rounded-xl border-l-4 border-error"
                     role="alert">
                    <span class="material-symbols-outlined text-error">error</span>
                    <span class="text-on-surface text-sm font-medium">@error</span>
                    <button type="button" onclick="this.parentElement.remove()"
                            class="ml-auto text-on-surface-variant hover:text-on-surface transition-colors">
                        <span class="material-symbols-outlined text-sm">close</span>
                    </button>
                </div>
            }
            @if (TempData[TempDataKeys.Info] is string info)
            {
                <div class="flex items-center gap-3 mb-6 p-4 bg-primary/10 rounded-xl border-l-4 border-primary"
                     role="alert">
                    <span class="material-symbols-outlined text-primary">info</span>
                    <span class="text-on-surface text-sm font-medium">@info</span>
                    <button type="button" onclick="this.parentElement.remove()"
                            class="ml-auto text-on-surface-variant hover:text-on-surface transition-colors">
                        <span class="material-symbols-outlined text-sm">close</span>
                    </button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    @* Mobile Bottom Nav: 4 icons, fixed bottom, hidden on md+ *@
    <nav class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 pb-4 pt-2 bg-surface-container-high/60 backdrop-blur-xl rounded-t-full shadow-[0_-4px_20px_rgba(0,0,0,0.4)]">
        <a asp-controller="Home" asp-action="Index"
           class="flex flex-col items-center justify-center px-5 py-2 text-on-surface/50 hover:text-primary transition-all active:scale-95">
            <span class="material-symbols-outlined">sports_soccer</span>
            <span class="text-[10px] font-bold uppercase tracking-[0.05em]">Home</span>
        </a>
        <a asp-controller="Torneo" asp-action="Index"
           class="flex flex-col items-center justify-center px-5 py-2 text-on-surface/50 hover:text-primary transition-all active:scale-95">
            <span class="material-symbols-outlined">emoji_events</span>
            <span class="text-[10px] font-bold uppercase tracking-[0.05em]">Leagues</span>
        </a>
        <a href="#"
           class="flex flex-col items-center justify-center px-5 py-2 text-on-surface/50 hover:text-primary transition-all active:scale-95">
            <span class="material-symbols-outlined">edit_note</span>
            <span class="text-[10px] font-bold uppercase tracking-[0.05em]">Predict</span>
        </a>
        <a asp-controller="Account" asp-action="Profile"
           class="flex flex-col items-center justify-center px-5 py-2 text-on-surface/50 hover:text-primary transition-all active:scale-95">
            <span class="material-symbols-outlined">account_circle</span>
            <span class="text-[10px] font-bold uppercase tracking-[0.05em]">Profile</span>
        </a>
    </nav>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
