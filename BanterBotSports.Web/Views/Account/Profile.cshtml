@model BanterBotSports.Entities.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

@* Profile & Bot Settings — mobile-first stacked cards, md: two-column layout.
   DESIGN.md tokens:
     - Glass cards: bg-[#1e253b]/60 backdrop-blur-sm rounded-2xl
     - Surface hierarchy: surface-container-low (#0d1323), surface-container-high (#181f33), surface-container-highest (#1e253b)
     - Tertiary (#ff7166) for destructive/danger elements
     - No 1px solid borders (No-Line rule) — use tonal shifts instead
     - Primary gradient for CTAs
   From: mockups/user_profile_bot_settings/code.html + mockups/mobile_mockups/user_profile_mobile/code.html *@

<!-- Ambient background glows -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute top-[-10%] right-[-5%] w-[40%] h-[40%] bg-primary/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[30%] h-[30%] bg-tertiary/5 blur-[120px] rounded-full"></div>
</div>

<div class="relative z-10">

    <!-- ── PAGE HEADER ── -->
    <header class="mb-8 md:mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="flex flex-col md:flex-row items-center md:items-end gap-6 md:gap-8">
            <!-- Avatar placeholder -->
            <div class="relative">
                <div class="absolute -inset-1 bg-gradient-to-tr from-primary to-secondary rounded-full blur opacity-20"></div>
                <div class="relative w-24 h-24 md:w-32 md:h-32 rounded-full bg-surface-container-high border-2 border-primary/30 flex items-center justify-center shadow-[0_0_40px_rgba(105,218,255,0.08)]">
                    <span class="material-symbols-outlined text-5xl md:text-6xl text-on-surface-variant">account_circle</span>
                </div>
            </div>
            <!-- Name & email -->
            <div class="text-center md:text-left">
                <h1 class="text-3xl md:text-5xl font-black tracking-tighter text-on-surface uppercase leading-tight">
                    @(Model.NombreDisplay ?? "Jugador")
                </h1>
                <p class="text-primary font-bold tracking-widest text-xs uppercase mt-1">
                    @Model.Email
                </p>
                <div class="mt-3 flex flex-wrap justify-center md:justify-start gap-2">
                    <span class="bg-surface-container-high px-3 py-1 rounded-full text-xs font-medium text-on-surface-variant">BanterBot Player</span>
                    @if (!string.IsNullOrEmpty(Model.TelegramChatId))
                    {
                        <span class="bg-secondary/10 text-secondary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest">
                            <span class="material-symbols-outlined text-xs align-middle">check_circle</span> Bot Activo
                        </span>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- ── MAIN GRID: mobile stacked, md: 2-column ── -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- ─────────────────────────────────────────────
             LEFT COLUMN (mobile: full, md: left)
             Stats + Telegram Integration
             ───────────────────────────────────────────── -->
        <div class="space-y-8">

            <!-- Stats Card -->
            <section>
                <h2 class="text-lg font-black tracking-tight uppercase border-l-4 border-primary pl-3 mb-4">
                    Estadísticas
                </h2>
                <div class="grid grid-cols-2 gap-4">
                    <!-- Total Points -->
                    <div class="bg-surface-container-high p-4 rounded-xl border-l-2 border-primary/40 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
                            <span class="material-symbols-outlined text-5xl">leaderboard</span>
                        </div>
                        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-black mb-1">Puntos Totales</p>
                        <p class="text-2xl font-black text-on-surface">—</p>
                    </div>
                    <!-- Win Rate -->
                    <div class="bg-surface-container-high p-4 rounded-xl border-l-2 border-secondary/40 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
                            <span class="material-symbols-outlined text-5xl">target</span>
                        </div>
                        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-black mb-1">% Aciertos</p>
                        <p class="text-2xl font-black text-secondary">—</p>
                    </div>
                    <!-- Tournaments Won -->
                    <div class="bg-surface-container-high p-4 rounded-xl border-l-2 border-primary/40 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
                            <span class="material-symbols-outlined text-5xl">military_tech</span>
                        </div>
                        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-black mb-1">Torneos Jugados</p>
                        <p class="text-2xl font-black text-on-surface">—</p>
                    </div>
                    <!-- Banter Score -->
                    <div class="bg-surface-container-high p-4 rounded-xl border-l-2 border-tertiary/40 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
                            <span class="material-symbols-outlined text-5xl">data_exploration</span>
                        </div>
                        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest font-black mb-1">Banter Score</p>
                        <p class="text-2xl font-black text-tertiary">—</p>
                    </div>
                </div>
            </section>

            <!-- Telegram Integration Card -->
            <section>
                <h2 class="text-lg font-black tracking-tight uppercase border-l-4 border-primary pl-3 mb-4">
                    Integración Telegram
                </h2>
                <div class="bg-[#1e253b]/60 backdrop-blur-sm rounded-2xl p-6 relative overflow-hidden shadow-[0_40px_40px_-15px_rgba(105,218,255,0.08)]">
                    <div class="absolute -top-10 -right-10 w-40 h-40 bg-primary/10 rounded-full blur-3xl"></div>
                    <div class="flex flex-col items-center gap-6 relative z-10">
                        <!-- Bot icon placeholder (no QR in MVP) -->
                        <div class="w-20 h-20 bg-surface-container-high rounded-2xl flex items-center justify-center shadow-[0_0_30px_rgba(105,218,255,0.15)]">
                            <span class="material-symbols-outlined text-primary text-4xl">smart_toy</span>
                        </div>
                        <div class="text-center">
                            <div class="flex items-center justify-center gap-2 mb-2">
                                <span class="material-symbols-outlined text-primary">send</span>
                                <h3 class="text-xl font-black tracking-tight">Vincular Telegram</h3>
                            </div>
                            <p class="text-on-surface-variant text-sm mb-4 leading-relaxed">
                                Conectá tu cuenta al bot de Telegram para recibir actualizaciones de resultados,
                                alertas de predicciones y el mejor banter directo en tu DM.
                            </p>
                            @if (!string.IsNullOrEmpty(Model.TelegramChatId))
                            {
                                <!-- Connected state: show Telegram Chat ID as a read-only field -->
                                <div class="flex items-center justify-center gap-3 mb-4">
                                    <span class="w-2 h-2 rounded-full bg-secondary shadow-[0_0_10px_#2ff801]"></span>
                                    <span class="text-xs font-bold uppercase tracking-widest text-secondary">Bot Conectado</span>
                                </div>
                                <div class="bg-surface-container-highest rounded-xl px-4 py-3 text-sm font-mono text-on-surface-variant text-center">
                                    Chat ID: @Model.TelegramChatId
                                </div>
                            }
                            else
                            {
                                <a href="https://t.me/BanterBotSports_bot"
                                   target="_blank" rel="noopener"
                                   class="inline-flex items-center justify-center gap-3 w-full bg-gradient-to-r from-primary to-primary-container text-on-primary-container py-4 rounded-xl font-bold uppercase tracking-wider shadow-[0_10px_20px_-5px_rgba(105,218,255,0.4)] active:scale-95 transition-all">
                                    <span class="material-symbols-outlined">send</span>
                                    Abrir Telegram Bot
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </section>

        </div><!-- /LEFT COLUMN -->

        <!-- ─────────────────────────────────────────────
             RIGHT COLUMN (mobile: full, md: right)
             Account Management + Bot Preferences
             ───────────────────────────────────────────── -->
        <div class="space-y-8">

            <!-- Account Management -->
            <section>
                <h2 class="text-lg font-black tracking-tight uppercase border-l-4 border-primary pl-3 mb-4">
                    Gestión de Cuenta
                </h2>
                <div class="bg-surface-container-low p-6 rounded-2xl space-y-6">
                    <!-- Display Name (read-only display) -->
                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                            Nombre de Jugador
                        </label>
                        <div class="w-full bg-surface-container-highest rounded-xl px-4 py-3 text-on-surface font-medium">
                            @(Model.NombreDisplay ?? "—")
                        </div>
                    </div>
                    <!-- Email (read-only display) -->
                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">
                            Email
                        </label>
                        <div class="w-full bg-surface-container-highest rounded-xl px-4 py-3 text-on-surface font-medium">
                            @(Model.Email ?? "—")
                        </div>
                    </div>
                </div>
            </section>

            <!-- Bot Preferences (static placeholders — UI only in this cycle) -->
            <section>
                <h2 class="text-lg font-black tracking-tight uppercase border-l-4 border-primary pl-3 mb-4">
                    Preferencias del Bot
                </h2>
                <div class="bg-surface-container-high rounded-2xl overflow-hidden">
                    <!-- Live Notifications -->
                    <div class="p-5 flex items-center justify-between border-b border-[#434759]/10">
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-primary">notifications_active</span>
                            <div>
                                <p class="text-sm font-bold uppercase">Notificaciones en Vivo</p>
                                <p class="text-xs text-on-surface-variant">Resultados en tiempo real</p>
                            </div>
                        </div>
                        <!-- Toggle placeholder (no JS wiring this cycle) -->
                        <div class="w-11 h-6 bg-primary rounded-full relative cursor-not-allowed opacity-60">
                            <div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full"></div>
                        </div>
                    </div>
                    <!-- Smart Predictions -->
                    <div class="p-5 flex items-center justify-between border-b border-[#434759]/10">
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-primary">auto_awesome</span>
                            <div>
                                <p class="text-sm font-bold uppercase">Predicciones IA</p>
                                <p class="text-xs text-on-surface-variant">Insights generados por BanterBot</p>
                            </div>
                        </div>
                        <div class="w-11 h-6 bg-surface-bright rounded-full relative cursor-not-allowed opacity-60">
                            <div class="absolute left-1 top-1 w-4 h-4 bg-outline rounded-full"></div>
                        </div>
                    </div>
                    <!-- Auto-Banter -->
                    <div class="p-5 flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <span class="material-symbols-outlined text-primary">chat</span>
                            <div>
                                <p class="text-sm font-bold uppercase">Auto-Banter</p>
                                <p class="text-xs text-on-surface-variant">Trash-talk automático al rival</p>
                            </div>
                        </div>
                        <div class="w-11 h-6 bg-primary rounded-full relative cursor-not-allowed opacity-60">
                            <div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full"></div>
                        </div>
                    </div>
                </div>
                <p class="text-[10px] text-on-surface-variant mt-3 ml-1 uppercase tracking-widest font-medium">
                    Configuración de notificaciones — próxima actualización
                </p>
            </section>

            <!-- Danger Zone -->
            <section>
                <h2 class="text-lg font-black tracking-tight uppercase border-l-4 border-tertiary pl-3 mb-4 text-tertiary">
                    Zona de Riesgo
                </h2>
                <div class="bg-surface-container-low rounded-2xl p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="font-bold text-on-surface text-sm">Cerrar Sesión en Todos los Dispositivos</p>
                            <p class="text-xs text-on-surface-variant mt-1">Se revocarán todas las sesiones activas</p>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            <button type="submit"
                                    class="text-tertiary border border-tertiary/20 px-4 py-2 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-tertiary/10 transition-colors active:scale-95">
                                <span class="material-symbols-outlined text-sm align-middle">logout</span>
                                Salir
                            </button>
                        </form>
                    </div>
                </div>
            </section>

        </div><!-- /RIGHT COLUMN -->

    </div><!-- /MAIN GRID -->

</div>
