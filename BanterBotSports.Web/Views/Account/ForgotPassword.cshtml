@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BanterBot Sports</title>
    @await Html.PartialAsync("_TailwindHead")
    <style>
        .stadium-mesh {
            background-image: radial-gradient(circle at 2px 2px, rgba(105, 218, 255, 0.05) 1px, transparent 0);
            background-size: 24px 24px;
        }
        .stadium-glow { box-shadow: 0 0 40px rgba(105, 218, 255, 0.1); }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen flex flex-col overflow-x-hidden">

    @* Fixed ambient background *@
    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute inset-0 bg-gradient-to-b from-surface-container-low via-background to-background"></div>
        <div class="absolute inset-0 stadium-mesh opacity-30"></div>
        <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-primary/10 blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-secondary/5 blur-[100px]"></div>
    </div>

    @* Mobile TopAppBar *@
    <header class="relative z-10 fixed top-0 w-full flex justify-between items-center px-6 h-16 bg-background shadow-[0_4px_40px_0_rgba(105,218,255,0.08)] md:hidden">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-2xl">sports_kabaddi</span>
            <span class="text-2xl font-black text-primary tracking-tighter uppercase">BANTERBOT</span>
        </div>
    </header>

    @* Main content *@
    <main class="relative z-10 flex-grow flex items-center justify-center p-6 pt-24 md:pt-6">
        <div class="w-full max-w-md">

            @* Branding header (desktop) *@
            <div class="text-center mb-12">
                <h1 class="text-4xl font-black italic tracking-tighter text-primary mb-2">BanterBot Sports</h1>
                <p class="text-on-surface-variant font-medium tracking-wide uppercase text-[0.7rem] opacity-60">
                    Acceso al Colosseum Digital
                </p>
            </div>

            @* Mobile hero visual *@
            <div class="w-full mb-10 relative text-center md:mb-0">
                <div class="absolute inset-0 bg-primary opacity-5 blur-[80px] rounded-full pointer-events-none"></div>
                <div class="relative z-10 md:hidden">
                    <span class="material-symbols-outlined text-primary text-7xl mb-4" style="font-variation-settings: 'wght' 200;">lock_reset</span>
                    <h2 class="text-[3rem] leading-none font-black tracking-tight text-on-surface uppercase mb-4">
                        ¿Perdiste <br/><span class="text-primary">el acceso?</span>
                    </h2>
                    <p class="text-on-surface-variant text-base max-w-[280px] mx-auto">
                        Hasta los MVPs olvidan sus credenciales. Volvamos a meterte en el juego.
                    </p>
                </div>
            </div>

            @* Recovery card *@
            <div class="relative group">
                @* Decorative glow layer *@
                <div class="absolute -inset-0.5 bg-gradient-to-r from-primary/20 to-transparent rounded-xl blur opacity-30 group-hover:opacity-50 transition duration-500"></div>

                <div class="relative bg-surface-container-low/80 backdrop-blur-2xl p-8 rounded-xl shadow-2xl stadium-glow">
                    <div class="mb-8">
                        <div class="flex items-center gap-3 mb-4 hidden md:flex">
                            <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center neon-glow-primary">
                                <span class="material-symbols-outlined text-background" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
                            </div>
                        </div>
                        <h2 class="text-2xl font-bold font-headline text-on-surface mb-2 tracking-tight">Recuperar contraseña</h2>
                        <p class="text-on-surface-variant text-sm leading-relaxed">
                            Ingresá tu email registrado. Te enviaremos un enlace para recuperar el acceso a tu cuenta.
                        </p>
                    </div>

                    @if (TempData[TempDataKeys.Success] is string successMsg)
                    {
                        <div class="flex items-center gap-3 mb-6 p-4 bg-secondary/10 rounded-xl border-l-4 border-secondary"
                             role="alert">
                            <span class="material-symbols-outlined text-secondary">check_circle</span>
                            <span class="text-on-surface text-sm font-medium">@successMsg</span>
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()

                        <div class="space-y-2">
                            <label for="email"
                                   class="block text-[0.65rem] font-black uppercase tracking-[0.15em] text-primary/80 ml-1">
                                Email registrado
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-lg">mail</span>
                                <input type="email"
                                       id="email"
                                       name="email"
                                       class="w-full bg-surface-container-highest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-outline/50 focus:ring-1 focus:ring-primary/40 focus:bg-surface-bright transition-all duration-300"
                                       placeholder="campeon@arena.gg"
                                       required />
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full relative overflow-hidden group/btn bg-gradient-to-br from-primary to-primary-container text-on-primary-container font-black py-4 rounded-xl shadow-[0_0_20px_rgba(105,218,255,0.2)] active:scale-95 transition-all duration-200">
                            <span class="relative z-10 flex items-center justify-center gap-2 tracking-tight">
                                Enviar enlace de recuperación
                                <span class="material-symbols-outlined text-sm">rocket_launch</span>
                            </span>
                            <div class="absolute inset-0 bg-white/20 translate-y-full group-hover/btn:translate-y-0 transition-transform duration-300"></div>
                        </button>
                    </form>

                    <div class="mt-10 pt-8 text-center">
                        <a asp-action="Login"
                           class="inline-flex items-center gap-2 text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors duration-200">
                            <span class="material-symbols-outlined text-sm">arrow_back</span>
                            Volver al login
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </main>

    @* Footer *@
    <footer class="relative z-10 py-8 px-6 text-center">
        <p class="text-xs text-on-surface-variant/40 font-medium tracking-widest uppercase">
            © 2026 BanterBot Sports
        </p>
    </footer>

</body>
</html>
