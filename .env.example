# BanterBot Sports — Environment Variables
# Copy this file to .env and fill in the values.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=banterbot_sports
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ─── API-Football ─────────────────────────────────────────────────────────────
# Obtain from https://www.api-football.com/
# Maps to ApiFootball:ApiKey in appsettings.json via double-underscore convention
ApiFootball__ApiKey=

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Obtain from https://console.anthropic.com/
# Maps to Anthropic:ApiKey in appsettings.json
ANTHROPIC_KEY=

# ─── OpenAI (Whisper) ─────────────────────────────────────────────────────────
# Obtain from https://platform.openai.com/api-keys
# Maps to Whisper:ApiKey in appsettings.json
WHISPER_KEY=
